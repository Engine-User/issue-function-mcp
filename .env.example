# Copy to .env and fill in. .env is gitignored; never commit the real values.

# Fine-grained PAT scoped to the one repo below.
# Create: https://github.com/settings/personal-access-tokens
# Permissions: Issues -> Read and write, Metadata -> Read-only (always required).
ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# owner/repo-name
GITHUB_REPO=username/my-project